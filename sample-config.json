{
  "sftpPluggin.mode": "teleport",
  "sftpPluggin.teleportHost": "teleport.example.com:3080",
  "sftpPluggin.teleportUser": "your_teleport_user",
  "sftpPluggin.teleportCluster": "main",
  "sftpPluggin.sftpHost": "target_node",
  "sftpPluggin.sftpUser": "deploy",
  "sftpPluggin.remotePath": "/srv/project",
  "sftpPluggin.localPath": "/absolute/path/to/project",
  "sftpPluggin.ignore": [
    "node_modules",
    ".env",
    "*.log"
  ],
  "sftpPluggin.concurrency": 4,
  "sftpPluggin.debounceMs": 300,
  "sftpPluggin.uploadOnSave": true,
  "sftpPluggin.uploadOnAutoSave": false
}
