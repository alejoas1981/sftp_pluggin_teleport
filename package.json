{
  "name": "sftp-pluggin",
  "displayName": "SFTP Plugin",
  "description": "FTP, FTPS, SFTP and Teleport file synchronization with a visual configuration panel and persistent upload queue.",
  "version": "3.2.1",
  "publisher": "alejoas1981",
  "author": {
    "name": "Savchenko Aleksey",
    "email": "alejoas1981@gmail.com"
  },
  "license": "MIT",
  "icon": "sftp_teleport.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/alejoas1981/sftp_pluggin_teleport"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:php",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:json",
    "onLanguage:yaml",
    "onLanguage:xml",
    "onLanguage:python",
    "onLanguage:markdown",
    "onLanguage:plaintext",
    "onCommand:sftpPluggin.openConfig",
    "onCommand:sftpPluggin.syncNow",
    "onCommand:sftpPluggin.dryRun",
    "onCommand:sftpPluggin.startWatching",
    "onCommand:sftpPluggin.stopWatching",
    "onCommand:sftpPluggin.cancelTransfer",
    "onCommand:sftpPluggin.teleportLogin",
    "onCommand:sftpPluggin.testTeleport",
    "onCommand:sftpPluggin.uploadActiveFile",
    "onCommand:sftpPluggin.downloadActiveFile",
    "onCommand:sftpPluggin.syncFile",
    "onCommand:sftpPluggin.deleteRemote",
    "onCommand:sftpPluggin.retryUploads"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sftpPluggin.openConfig",
        "title": "SFTP: Open Configuration"
      },
      {
        "command": "sftpPluggin.syncNow",
        "title": "SFTP: Sync Now"
      },
      {
        "command": "sftpPluggin.dryRun",
        "title": "SFTP: Dry Run"
      },
      {
        "command": "sftpPluggin.startWatching",
        "title": "SFTP: Start Watching"
      },
      {
        "command": "sftpPluggin.stopWatching",
        "title": "SFTP: Stop Watching"
      },
      {
        "command": "sftpPluggin.cancelTransfer",
        "title": "SFTP: Cancel Active Transfer"
      },
      {
        "command": "sftpPluggin.teleportLogin",
        "title": "SFTP: Teleport Login"
      },
      {
        "command": "sftpPluggin.testTeleport",
        "title": "SFTP: Test Connection"
      },
      {
        "command": "sftpPluggin.uploadActiveFile",
        "title": "Upload",
        "icon": {
          "light": "resources/icons/upload-light.svg",
          "dark": "resources/icons/upload-dark.svg"
        }
      },
      {
        "command": "sftpPluggin.downloadActiveFile",
        "title": "Download",
        "icon": {
          "light": "resources/icons/download-light.svg",
          "dark": "resources/icons/download-dark.svg"
        }
      },
      {
        "command": "sftpPluggin.syncFile",
        "title": "SFTP: Sync Active File"
      },
      {
        "command": "sftpPluggin.deleteRemote",
        "title": "SFTP: Delete Remote File"
      },
      {
        "command": "sftpPluggin.retryUploads",
        "title": "SFTP Retry Pending Uploads"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sftpPluggin.uploadActiveFile",
          "when": "explorerResourceIsFile",
          "group": "6_sftp@1"
        },
        {
          "command": "sftpPluggin.downloadActiveFile",
          "when": "explorerResourceIsFile",
          "group": "6_sftp@2"
        },
        {
          "command": "sftpPluggin.syncFile",
          "when": "explorerResourceIsFile",
          "group": "6_sftp@3"
        },
        {
          "command": "sftpPluggin.deleteRemote",
          "when": "explorerResourceIsFile",
          "group": "6_sftp@4"
        }
      ],
      "editor/title": [
        {
          "command": "sftpPluggin.uploadActiveFile",
          "when": "sftpPluggin.showUploadButton && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "sftpPluggin.downloadActiveFile",
          "when": "sftpPluggin.showDownloadButton && resourceScheme == file",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "SFTP Plugin",
      "properties": {
        "sftpPluggin.mode": {
          "type": "string",
          "enum": [
            "ftp",
            "sftp",
            "teleport"
          ],
          "default": "ftp",
          "description": "Connection mode"
        },
        "sftpPluggin.ftpHost": {
          "type": "string",
          "default": "",
          "description": "FTP host"
        },
        "sftpPluggin.ftpUser": {
          "type": "string",
          "default": "",
          "description": "FTP user"
        },
        "sftpPluggin.ftpPort": {
          "type": "number",
          "default": 21,
          "description": "FTP port (default 21)"
        },
        "sftpPluggin.sftpHost": {
          "type": "string",
          "default": "",
          "description": "SFTP host"
        },
        "sftpPluggin.sftpUser": {
          "type": "string",
          "default": "",
          "description": "SFTP user"
        },
        "sftpPluggin.sftpPort": {
          "type": "number",
          "default": 22,
          "description": "SSH port for SFTP mode. Teleport connections use tsh routing instead."
        },
        "sftpPluggin.teleportHost": {
          "type": "string",
          "default": "",
          "description": "Teleport proxy host"
        },
        "sftpPluggin.teleportUser": {
          "type": "string",
          "default": "",
          "description": "Teleport user"
        },
        "sftpPluggin.teleportCluster": {
          "type": "string",
          "default": "",
          "description": "Teleport cluster"
        },
        "sftpPluggin.remotePath": {
          "type": "string",
          "default": "",
          "description": "Remote path"
        },
        "sftpPluggin.localPath": {
          "type": "string",
          "default": "",
          "description": "Absolute local project directory. The plugin does not expand workspaceFolder or environment variables."
        },
        "sftpPluggin.privateKey": {
          "type": "string",
          "default": "",
          "description": "SSH private key path or inline key content for SFTP mode only. Saved form values are ordinary workspace state, not SecretStorage."
        },
        "sftpPluggin.passphrase": {
          "type": "string",
          "default": "",
          "description": "Private key passphrase for SFTP mode only. Saved form values are ordinary workspace state, not SecretStorage."
        },
        "sftpPluggin.agent": {
          "type": "string",
          "default": "",
          "description": "SSH agent socket path or pageant for SFTP mode only. Teleport uses tsh credentials."
        },
        "sftpPluggin.ignore": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Ignore patterns applied to both directions and queued uploads. Built in exclusions always include .git, .vscode and .sftp-sync."
        },
        "sftpPluggin.concurrency": {
          "type": "integer",
          "default": 4,
          "description": "Parallel file workers from 1 to 16. FTP and FTPS use separate connections. Teleport save batches use one rsync session.",
          "minimum": 1,
          "maximum": 16
        },
        "sftpPluggin.ftpPassive": {
          "type": "boolean",
          "default": true,
          "description": "Prefer IPv4 passive FTP when enabled. When disabled, use the library default passive strategy. Active FTP is not implemented."
        },
        "sftpPluggin.ftpSecure": {
          "type": "boolean",
          "default": false,
          "description": "Use FTPS (TLS) \u2014 encrypted FTP connection; enable if the server requires AUTH TLS"
        },
        "sftpPluggin.identity": {
          "type": "string",
          "default": "",
          "description": "Legacy SFTP key path used only when privateKey is undefined. Prefer privateKey.",
          "deprecationMessage": "Legacy SFTP key path used only when privateKey is undefined. Prefer privateKey."
        },
        "sftpPluggin.sshFlags": {
          "type": "string",
          "default": "",
          "description": "Legacy compatibility field. Not used by the current transports.",
          "deprecationMessage": "Legacy compatibility field. Not used by the current transports."
        },
        "sftpPluggin.rsyncFlags": {
          "type": "string",
          "default": "",
          "description": "Teleport only. Supports --bwlimit=N, --exclude PATTERN and --exclude=PATTERN. Exclusions join Ignore rules. Other flags are rejected."
        },
        "sftpPluggin.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "File watcher debounce in milliseconds"
        },
        "sftpPluggin.useRsync": {
          "type": "boolean",
          "default": false,
          "description": "Legacy compatibility field. Does not select a transport. SFTP uses ssh2 and Teleport always uses tsh with rsync.",
          "deprecationMessage": "Legacy compatibility field. Does not select a transport. SFTP uses ssh2 and Teleport always uses tsh with rsync."
        },
        "sftpPluggin.useTeleport": {
          "type": "boolean",
          "default": false,
          "description": "Legacy mode fallback used only when mode is absent. Select mode explicitly for new configurations.",
          "deprecationMessage": "Legacy mode fallback used only when mode is absent. Select mode explicitly for new configurations."
        },
        "sftpPluggin.uploadOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Upload queued local project changes after manual save. Local copies overwrite remote copies. Does not run two way conflict detection."
        },
        "sftpPluggin.uploadOnAutoSave": {
          "type": "boolean",
          "default": false,
          "description": "Upload queued local changes after editor Auto Save or observed workspace file events. Does not enable editor Auto Save or scan the whole project."
        },
        "sftpPluggin.showUploadButton": {
          "type": "boolean",
          "default": false,
          "description": "Show Upload in the editor title. After saving a private configuration, change this preference in the configuration panel."
        },
        "sftpPluggin.showDownloadButton": {
          "type": "boolean",
          "default": false,
          "description": "Show Download in the editor title. After saving a private configuration, change this preference in the configuration panel."
        },
        "sftpPluggin.scanConcurrency": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Remote directory scan concurrency from 1 to 16 where individual listings are used. Full Teleport analysis uses one recursive remote command."
        },
        "sftpPluggin.verifyContents": {
          "type": "boolean",
          "default": false,
          "description": "Read all local file contents during analysis instead of reusing hashes for unchanged metadata."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "npm run compile && node scripts/bundle.cjs",
    "watch": "tsc -watch -p ./",
    "test": "mocha --require ts-node/register --require src/test/setup.js 'src/test/**/*.test.ts'",
    "build:extension": "mkdir -p build && vsce package --no-dependencies -o build/"
  },
  "devDependencies": {
    "@types/chai": "4.3.11",
    "@types/mocha": "10.0.6",
    "@types/node": "^26.2.0",
    "@types/proxyquire": "^1.3.31",
    "@types/ssh2": "^1.15.5",
    "@types/tar": "^6.1.13",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "2.24.0",
    "chai": "4.4.1",
    "esbuild": "^0.25.12",
    "mocha": "10.4.0",
    "proxyquire": "^2.1.3",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "basic-ftp": "^5.3.1",
    "ignore": "^5.3.2",
    "p-queue": "^6.6.2",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "upath": "^2.0.1"
  },
  "homepage": "https://github.com/alejoas1981/sftp_pluggin_teleport#readme",
  "bugs": {
    "url": "https://github.com/alejoas1981/sftp_pluggin_teleport/issues"
  },
  "keywords": [
    "ftp",
    "ftps",
    "sftp",
    "teleport",
    "sync",
    "upload"
  ]
}
