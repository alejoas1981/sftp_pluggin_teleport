{
  "name": "sftp-pluggin",
  "displayName": "SFTP Plugin",
  "description": "VS Code plugin for SFTP with Teleport integration",
  "version": "2.0.2",
  "publisher": "your-publisher",
  "license": "MIT",
  "icon": "sftp_teleport.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-publisher/sftp_pluggin_teleport"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sftpPluggin.openConfig",
        "title": "SFTP: Open Configuration"
      },
      {
        "command": "sftpPluggin.syncNow",
        "title": "SFTP: Sync Now"
      },
      {
        "command": "sftpPluggin.dryRun",
        "title": "SFTP: Dry Run"
      },
      {
        "command": "sftpPluggin.startWatching",
        "title": "SFTP: Start Watching"
      },
      {
        "command": "sftpPluggin.stopWatching",
        "title": "SFTP: Stop Watching"
      },
      {
        "command": "sftpPluggin.teleportLogin",
        "title": "SFTP: Teleport Login"
      },
      {
        "command": "sftpPluggin.testTeleport",
        "title": "SFTP: Test Teleport Connection"
      }
    ]
  },
  "configuration": {
    "title": "SFTP Plugin",
    "properties": {
      "sftpPluggin.uploadOnSave": {
        "type": "boolean",
        "default": true,
        "description": "Upload current file after manual save (Ctrl+S)"
      },
      "sftpPluggin.uploadOnAutoSave": {
        "type": "boolean",
        "default": false,
        "description": "Upload current file after auto-save"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha --require ts-node/register 'src/test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/chai": "4.3.11",
    "@types/mocha": "10.0.6",
    "@types/node": "20.11.5",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "2.24.0",
    "chai": "4.4.1",
    "mocha": "10.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  }
}
