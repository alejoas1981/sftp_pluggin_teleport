{
  "name": "sftp-pluggin",
  "displayName": "SFTP Plugin",
  "description": "VS Code plugin for SFTP with Teleport integration",
  "version": "3.0.0",
  "publisher": "alejoas1981",
  "author": {
    "name": "Savchenko Aleksey",
    "email": "alejoas1981@gmail.com"
  },
  "license": "MIT",
  "icon": "sftp_teleport.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/alejoas1981/sftp_pluggin_teleport"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sftpPluggin.openConfig",
        "title": "SFTP: Open Configuration"
      },
      {
        "command": "sftpPluggin.syncNow",
        "title": "SFTP: Sync Now"
      },
      {
        "command": "sftpPluggin.dryRun",
        "title": "SFTP: Dry Run"
      },
      {
        "command": "sftpPluggin.startWatching",
        "title": "SFTP: Start Watching"
      },
      {
        "command": "sftpPluggin.stopWatching",
        "title": "SFTP: Stop Watching"
      },
      {
        "command": "sftpPluggin.teleportLogin",
        "title": "SFTP: Teleport Login"
      },
      {
        "command": "sftpPluggin.testTeleport",
        "title": "SFTP: Test Connection"
      },
      {
        "command": "sftpPluggin.uploadActiveFile",
        "title": "SFTP: Upload Active File"
      },
      {
        "command": "sftpPluggin.downloadActiveFile",
        "title": "SFTP: Download Active File"
      },
      {
        "command": "sftpPluggin.syncFile",
        "title": "SFTP: Sync Active File"
      },
      {
        "command": "sftpPluggin.deleteRemote",
        "title": "SFTP: Delete Remote File"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sftpPluggin.uploadActiveFile",
          "when": "explorerResourceIsFile",
          "group": "6_sftp@1"
        },
        {
          "command": "sftpPluggin.downloadActiveFile",
          "when": "explorerResourceIsFile",
          "group": "6_sftp@2"
        },
        {
          "command": "sftpPluggin.syncFile",
          "when": "explorerResourceIsFile",
          "group": "6_sftp@3"
        },
        {
          "command": "sftpPluggin.deleteRemote",
          "when": "explorerResourceIsFile",
          "group": "6_sftp@4"
        }
      ],
      "editor/title": [
        {
          "command": "sftpPluggin.uploadActiveFile",
          "when": "resourceFilename",
          "group": "navigation@1"
        },
        {
          "command": "sftpPluggin.downloadActiveFile",
          "when": "resourceFilename",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "SFTP Plugin",
      "properties": {
        "sftpPluggin.mode": {
          "type": "string",
          "enum": [
            "ftp",
            "sftp",
            "teleport"
          ],
          "default": "ftp",
          "description": "Connection mode"
        },
        "sftpPluggin.ftpHost": {
          "type": "string",
          "default": "",
          "description": "FTP host"
        },
        "sftpPluggin.ftpUser": {
          "type": "string",
          "default": "",
          "description": "FTP user"
        },
        "sftpPluggin.ftpPort": {
          "type": "number",
          "default": 21,
          "description": "FTP port (default 21)"
        },
        "sftpPluggin.sftpHost": {
          "type": "string",
          "default": "",
          "description": "SFTP host"
        },
        "sftpPluggin.sftpUser": {
          "type": "string",
          "default": "",
          "description": "SFTP user"
        },
        "sftpPluggin.sftpPort": {
          "type": "number",
          "default": 22,
          "description": "SFTP/SSH port (default 22)"
        },
        "sftpPluggin.teleportHost": {
          "type": "string",
          "default": "",
          "description": "Teleport proxy host"
        },
        "sftpPluggin.teleportUser": {
          "type": "string",
          "default": "",
          "description": "Teleport user"
        },
        "sftpPluggin.teleportCluster": {
          "type": "string",
          "default": "",
          "description": "Teleport cluster"
        },
        "sftpPluggin.remotePath": {
          "type": "string",
          "default": "",
          "description": "Remote path"
        },
        "sftpPluggin.localPath": {
          "type": "string",
          "default": "",
          "description": "Local project path"
        },
        "sftpPluggin.privateKey": {
          "type": "string",
          "default": "",
          "description": "SSH private key path or key content"
        },
        "sftpPluggin.passphrase": {
          "type": "string",
          "default": "",
          "description": "Passphrase for the SSH private key"
        },
        "sftpPluggin.agent": {
          "type": "string",
          "default": "",
          "description": "SSH agent socket or 'pageant'"
        },
        "sftpPluggin.ignore": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Patterns to ignore during sync"
        },
        "sftpPluggin.concurrency": {
          "type": "number",
          "default": 4,
          "description": "Number of parallel file transfers"
        },
        "sftpPluggin.ftpPassive": {
          "type": "boolean",
          "default": true,
          "description": "Use passive mode for FTP"
        },
        "sftpPluggin.ftpSecure": {
          "type": "boolean",
          "default": false,
          "description": "Use FTPS (TLS) — encrypted FTP connection; enable if the server requires AUTH TLS"
        },
        "sftpPluggin.identity": {
          "type": "string",
          "default": "",
          "description": "SSH private key path"
        },
        "sftpPluggin.sshFlags": {
          "type": "string",
          "default": "",
          "description": "Extra SSH flags"
        },
        "sftpPluggin.rsyncFlags": {
          "type": "string",
          "default": "",
          "description": "Extra rsync flags"
        },
        "sftpPluggin.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "File watcher debounce in milliseconds"
        },
        "sftpPluggin.useRsync": {
          "type": "boolean",
          "default": false,
          "description": "Use rsync for SFTP sync (otherwise lftp)"
        },
        "sftpPluggin.useTeleport": {
          "type": "boolean",
          "default": false,
          "description": "Use Teleport for connection"
        },
        "sftpPluggin.uploadOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Upload current file after manual save (Ctrl+S)"
        },
        "sftpPluggin.uploadOnAutoSave": {
          "type": "boolean",
          "default": false,
          "description": "Upload current file after auto-save"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha --require ts-node/register --require src/test/setup.js 'src/test/**/*.test.ts'",
    "build:extension": "mkdir -p build && vsce package --dependencies -o build/"
  },
  "devDependencies": {
    "@types/chai": "4.3.11",
    "@types/mocha": "10.0.6",
    "@types/node": "20.11.5",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "2.24.0",
    "chai": "4.4.1",
    "mocha": "10.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "basic-ftp": "^5.3.1",
    "ignore": "^5.3.2",
    "p-queue": "^6.6.2",
    "ssh2": "^1.17.0",
    "upath": "^2.0.1"
  }
}
